{
  "$schema": "../../../schema/portable.schema.json",
  "name": "path-set-grow-array",
  "description": "Setting an index beyond the array length pads with nulls.",
  "function": "path_set",
  "priority": "P0",
  "input": {
    "value": { "items": [1, 2] },
    "path": "items.5",
    "new_value": "X"
  },
  "expected": { "items": [1, 2, null, null, null, "X"] }
}
