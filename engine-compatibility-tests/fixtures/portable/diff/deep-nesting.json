{
  "$schema": "../../../schema/portable.schema.json",
  "name": "diff-deep-nesting",
  "description": "A leaf change ten levels down emits one full dotted path.",
  "function": "diff_paths",
  "priority": "P1",
  "input": {
    "old": {
      "l1": {
        "l2": {
          "l3": {
            "l4": {
              "l5": {
                "l6": {
                  "l7": {
                    "l8": {
                      "l9": {
                        "l10": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "new": {
      "l1": {
        "l2": {
          "l3": {
            "l4": {
              "l5": {
                "l6": {
                  "l7": {
                    "l8": {
                      "l9": {
                        "l10": 2
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "expected": [
    {
      "path": "l1.l2.l3.l4.l5.l6.l7.l8.l9.l10",
      "value": 2
    }
  ]
}
