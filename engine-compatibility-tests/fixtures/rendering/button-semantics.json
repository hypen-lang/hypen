{
  "$schema": "../../schema/test-case.schema.json",
  "name": "button-create-semantics",
  "description": "Create patches carry the derived accessibility semantics block: Button(\"Save\") pins {role: button, name: Save} on the wire",
  "category": "rendering",
  "priority": "P0",

  "input": {
    "source": "Button(\"Save\")",
    "initialState": {},
