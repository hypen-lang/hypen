{
  "$schema": "../../schema/test-case.schema.json",
  "name": "safe-area",
  "description": "SafeArea expands as a primitive element; `edges` is passed through as a list prop and is absent when not specified",
  "category": "rendering",
  "priority": "P1",

  "input": {
    "source": "Column { SafeArea { Text(\"Default\") } SafeArea(edges: [\"top\", \"bottom\"]) { Text(\"Filtered\") } }",
    "initialState": {},
    "module": {
      "name": "TestModule",
      "actions": [],
      "stateKeys": []
    }
  },

  "expected": {
    "patchCount": 10,
    "patches": [
      { "type": "create", "elementType": "Column" },
      {
        "type": "create",
