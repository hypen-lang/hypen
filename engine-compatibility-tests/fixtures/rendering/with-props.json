{
  "$schema": "../../schema/test-case.schema.json",
  "name": "component-with-props",
  "description": "Renders components with various prop types (string, number, boolean, list, map)",
  "category": "rendering",
  "priority": "P0",

  "input": {
    "source": "Button(text: \"Submit\", width: 100, height: 50.5, enabled: true)",
    "initialState": {},
    "module": {
      "name": "TestModule",
      "actions": [],
      "stateKeys": []
    }
  },

  "expected": {
    "patchCount": 2,
    "patchTypes": ["create", "insert"],
    "patches": [
      {
        "type": "create",
        "elementType": "Button",
        "props": {
          "text": "Submit",
          "width": 100,
          "height": 50.5,
          "enabled": true
        }
      },
      { "type": "insert" }
    ]
  }
}
