          "moduleInstanceId": "profile-7",
          "activationId": 3
        },
        "lifetime": "activation",
        "timeoutMs": 600000,
        "initialCredit": 32,
        "params": {
          "sampleRate": 48000,
          "format": "pcm16",
          "maxDurationMs": 600000,
          "channels": 2
        }
      }
    },
    {
