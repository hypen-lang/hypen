        },
        "lifetime": "connection",
        "timeoutMs": 86400000,
        "initialCredit": 8,
        "params": {}
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 2,
        "capability": "gallery.pick",
        "version": 1,
        "owner": {
          "moduleInstanceId": "profile-7",
          "activationId": 3
        },
        "lifetime": "activation",
        "timeoutMs": 300000,
        "initialCredit": 16,
        "params": {
          "mediaTypes": [
            "photo"
          ],
          "maxCount": 2
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 2,
        "event": {
          "kind": "blobStart",
          "channel": 0,
          "contentType": "image/jpeg",
          "bytes": 17
