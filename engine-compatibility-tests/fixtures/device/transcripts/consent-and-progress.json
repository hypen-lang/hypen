{
  "name": "consent-and-progress",
  "description": "Host-owned consent: optional progress events report pendingConsent then running (they consume no credit and server correctness never depends on them; they never go back to pendingConsent); the lease stays live while consent is pending; a permission.request succeeds. While one prompt is pending, a second prompting request is throttled; the pending one then resolves (here: denied by the user).",
  "protocol": 1,
  "steps": [
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 1,
        "capability": "core.capabilities",
        "version": 1,
        "owner": {
          "connection": true
        },
        "lifetime": "connection",
        "timeoutMs": 86400000,
        "initialCredit": 8,
        "params": {}
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 2,
        "capability": "permission.request",
        "version": 1,
        "owner": {
          "moduleInstanceId": "profile-7",
          "activationId": 3
        },
        "lifetime": "activation",
        "timeoutMs": 300000,
        "initialCredit": 0,
        "params": {
          "permission": "camera"
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 2,
        "event": {
          "kind": "progress",
          "state": "pendingConsent"
        }
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceEvent",
        "id": 2,
        "control": {
          "renewLease": 1
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 2,
        "control": {
          "leaseAck": 1
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 2,
        "event": {
          "kind": "progress",
          "state": "running"
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 2,
        "event": {
          "kind": "progress",
          "state": "running"
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceResponse",
        "id": 2,
        "result": {
          "status": "granted"
        }
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 3,
        "capability": "gallery.pick",
        "version": 1,
        "owner": {
          "moduleInstanceId": "profile-7",
          "activationId": 3
        },
        "lifetime": "activation",
        "timeoutMs": 300000,
        "initialCredit": 65536,
        "params": {
          "mediaTypes": [
            "photo"
          ],
          "maxCount": 1
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 3,
        "event": {
          "kind": "progress",
          "state": "pendingConsent"
        }
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 4,
        "capability": "permission.request",
        "version": 1,
        "owner": {
          "moduleInstanceId": "profile-7",
          "activationId": 3
        },
        "lifetime": "activation",
        "timeoutMs": 300000,
        "initialCredit": 0,
        "params": {
          "permission": "microphone"
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceResponse",
        "id": 4,
        "error": {
          "code": "throttled"
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceResponse",
        "id": 3,
        "error": {
          "code": "denied",
          "platformDetail": "user-declined"
        }
      }
    }
  ]
}
