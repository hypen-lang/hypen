{
  "name": "violation-request-from-client",
  "description": "Only the server sends deviceRequest. A client deviceRequest reusing a live server id is a known-id wrong-direction message: the server cancels request 1 and settles it with invalidParams. (A client request for a non-live id is simply ignored: unknown-ids-ignored-in-any-direction.)",
  "protocol": 1,
  "steps": [
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 1,
        "capability": "core.capabilities",
        "version": 1,
        "owner": {
          "connection": true
        },
        "lifetime": "connection",
        "timeoutMs": 86400000,
        "initialCredit": 8,
        "params": {}
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 2,
        "capability": "permission.query",
        "version": 1,
        "owner": {
          "moduleInstanceId": "profile-7",
          "activationId": 3
        },
        "lifetime": "activation",
        "timeoutMs": 30000,
        "initialCredit": 0,
        "params": {
          "permission": "microphone"
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceRequest",
        "id": 2,
        "capability": "permission.query",
        "version": 1,
        "owner": {
          "moduleInstanceId": "profile-7",
          "activationId": 3
        },
        "lifetime": "activation",
        "timeoutMs": 30000,
        "initialCredit": 0,
        "params": {
          "permission": "microphone"
        }
      },
      "expectViolation": "direction"
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceEvent",
        "id": 2,
        "control": {
          "cancel": true
        }
      },
      "reaction": true
    }
  ]
}
