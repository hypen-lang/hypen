{
  "name": "camera-capture-cancelled",
  "description": "Dismissing the host capture UI is `cancelled` (not a permission denial); a camera permission refused by the OS is `denied`. Nothing is uploaded in either case.",
  "protocol": 1,
  "steps": [
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 1,
        "capability": "core.capabilities",
        "version": 1,
        "owner": {
          "connection": true
        },
        "lifetime": "connection",
        "timeoutMs": 86400000,
        "initialCredit": 8,
        "params": {}
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 2,
        "capability": "camera.capture",
        "version": 1,
        "owner": {
          "moduleInstanceId": "profile-7",
          "activationId": 3
        },
        "lifetime": "activation",
        "timeoutMs": 600000,
        "initialCredit": 65536,
        "params": {
          "mode": "photo"
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 2,
        "event": {
          "kind": "progress",
          "state": "pendingConsent"
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceResponse",
        "id": 2,
        "error": {
          "code": "cancelled",
          "platformDetail": "capture-dismissed"
        }
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 3,
        "capability": "camera.capture",
        "version": 1,
        "owner": {
          "moduleInstanceId": "profile-7",
          "activationId": 3
        },
        "lifetime": "activation",
        "timeoutMs": 600000,
        "initialCredit": 65536,
        "params": {
          "mode": "video",
          "maxDurationMs": 5000
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceResponse",
        "id": 3,
        "error": {
          "code": "denied",
          "platformDetail": "camera"
        }
      }
    }
  ]
}
