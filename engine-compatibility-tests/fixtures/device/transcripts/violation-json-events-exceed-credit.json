{
  "name": "violation-json-events-exceed-credit",
  "description": "JSON stream credit counts events: one credit, two scan events.",
  "protocol": 1,
  "steps": [
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 1,
        "capability": "core.capabilities",
        "version": 1,
        "owner": {
          "connection": true
        },
        "lifetime": "connection",
        "timeoutMs": 86400000,
        "initialCredit": 8,
        "params": {}
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 2,
        "capability": "bluetooth.scan",
        "version": 1,
        "owner": {
          "moduleInstanceId": "profile-7",
          "activationId": 3
        },
        "lifetime": "activation",
        "timeoutMs": 600000,
        "initialCredit": 1,
        "params": {}
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 2,
        "event": {
          "device": {
            "id": "a",
            "rssi": -1
          }
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 2,
        "event": {
          "device": {
            "id": "b",
            "rssi": -2
          }
        }
      },
      "expectViolation": "credit"
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceEvent",
        "id": 2,
        "control": {
          "cancel": true
        }
      },
      "reaction": true
    }
  ]
}
