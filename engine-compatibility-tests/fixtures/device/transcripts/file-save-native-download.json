{
  "name": "file-save-native-download",
  "description": "Native file.save download plane (C1): initialCredit 0; the host shows its consent and the system destination picker FIRST (pendingConsent, lease live meanwhile), and only after the destination is chosen grants a bounded window (<= 256 KiB, <= maxOutstandingCredit). Frames are at most 64 KiB, never empty, seq contiguous from 0; the host streams to the destination (or a temp file) and replenishes credit as it writes, then verifies byte count and sha256 against the params before answering {bytesWritten}.",
  "protocol": 1,
  "steps": [
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 1,
        "capability": "core.capabilities",
        "version": 1,
        "owner": {
          "connection": true
        },
        "lifetime": "connection",
        "timeoutMs": 86400000,
        "initialCredit": 8,
        "params": {}
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 2,
        "capability": "file.save",
        "version": 1,
        "owner": {
          "moduleInstanceId": "profile-7",
          "activationId": 3
        },
        "lifetime": "activation",
        "timeoutMs": 300000,
        "initialCredit": 0,
        "params": {
          "channel": 0,
          "name": "export.bin",
          "contentType": "application/octet-stream",
          "bytes": 100000,
          "sha256": "f734fc90ca6f928f4e772a31dba36dd6924c80bd654c3681f15ee7725eaac713"
        }
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceEvent",
        "id": 2,
        "control": {
          "renewLease": 1
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 2,
        "event": {
          "kind": "progress",
          "state": "pendingConsent"
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 2,
        "control": {
          "leaseAck": 1
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 2,
        "event": {
          "kind": "progress",
          "state": "running"
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 2,
        "control": {
          "grant": 65536
        }
      }
    },
    {
      "dir": "s2c",
      "frame": {
        "header": {
          "version": 1,
          "flags": 0,
          "channel": 0,
          "requestId": 2,
          "seq": 0
        },
        "hex": "010000000200000000000000",
        "payloadFill": {
          "byte": 90,
          "length": 65536
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 2,
        "control": {
          "grant": 65536
        }
      }
    },
    {
      "dir": "s2c",
      "frame": {
        "header": {
          "version": 1,
          "flags": 0,
          "channel": 0,
          "requestId": 2,
          "seq": 1
        },
        "hex": "010000000200000001000000",
        "payloadFill": {
          "byte": 90,
          "length": 34464
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceResponse",
        "id": 2,
        "result": {
          "bytesWritten": 100000
        }
      }
    }
  ]
}
