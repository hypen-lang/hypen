{
  "name": "permission-query-unsupported",
  "description": "Typed permissions (P1): every host maps the same closed enum. A host that cannot represent a permission at all answers `unsupported` with platformDetail = the permission name (here contacts on the web); representable ones answer a status, `photos` is granted on the web (the file picker needs no permission), and permission.request follows the same rule.",
  "protocol": 1,
  "steps": [
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 1,
        "capability": "core.capabilities",
        "version": 1,
        "owner": {
          "connection": true
        },
        "lifetime": "connection",
        "timeoutMs": 86400000,
        "initialCredit": 8,
        "params": {}
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 2,
        "capability": "permission.query",
        "version": 1,
        "owner": {
          "moduleInstanceId": "profile-7",
          "activationId": 3
        },
        "lifetime": "activation",
        "timeoutMs": 30000,
        "initialCredit": 0,
        "params": {
          "permission": "contacts"
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceResponse",
        "id": 2,
        "error": {
          "code": "unsupported",
          "platformDetail": "contacts"
        }
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 3,
        "capability": "permission.query",
        "version": 1,
        "owner": {
          "moduleInstanceId": "profile-7",
          "activationId": 3
        },
        "lifetime": "activation",
        "timeoutMs": 30000,
        "initialCredit": 0,
        "params": {
          "permission": "photos"
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceResponse",
        "id": 3,
        "result": {
          "status": "granted"
        }
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 4,
        "capability": "permission.query",
        "version": 1,
        "owner": {
          "moduleInstanceId": "profile-7",
          "activationId": 3
        },
        "lifetime": "activation",
        "timeoutMs": 30000,
        "initialCredit": 0,
        "params": {
          "permission": "bluetooth"
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceResponse",
        "id": 4,
        "result": {
          "status": "prompt"
        }
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 5,
        "capability": "permission.request",
        "version": 1,
        "owner": {
          "moduleInstanceId": "profile-7",
          "activationId": 3
        },
        "lifetime": "activation",
        "timeoutMs": 300000,
        "initialCredit": 0,
        "params": {
          "permission": "contacts"
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceResponse",
        "id": 5,
        "error": {
          "code": "unsupported",
          "platformDetail": "contacts"
        }
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 6,
        "capability": "permission.request",
        "version": 1,
        "owner": {
          "moduleInstanceId": "profile-7",
          "activationId": 3
        },
        "lifetime": "activation",
        "timeoutMs": 300000,
        "initialCredit": 0,
        "params": {
          "permission": "location"
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 6,
        "event": {
          "kind": "progress",
          "state": "pendingConsent"
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceResponse",
        "id": 6,
        "result": {
          "status": "denied"
        }
      }
    }
  ]
