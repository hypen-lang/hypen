{
  "name": "violation-bluetooth-select-bad-service-uuid",
  "description": "bluetooth.select@1 service UUIDs use the canonical lowercase 128-bit form; the 16-bit short form \"0x180d\" must be sent expanded (0000180d-0000-1000-8000-00805f9b34fb).",
  "protocol": 1,
  "steps": [
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 1,
        "capability": "core.capabilities",
        "version": 1,
        "owner": {
          "connection": true
        },
        "lifetime": "connection",
        "timeoutMs": 86400000,
        "initialCredit": 8,
        "params": {}
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 2,
        "capability": "bluetooth.select",
        "version": 1,
        "owner": {
          "moduleInstanceId": "profile-7",
          "activationId": 3
        },
        "lifetime": "activation",
        "timeoutMs": 300000,
        "initialCredit": 0,
        "params": {
          "services": [
            "0x180d"
          ]
        }
      },
      "expectViolation": "invalidPayload"
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceResponse",
        "id": 2,
        "error": {
          "code": "invalidParams"
        }
      },
      "reaction": true
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 3,
        "capability": "bluetooth.select",
        "version": 1,
        "owner": {
          "moduleInstanceId": "profile-7",
          "activationId": 3
        },
        "lifetime": "activation",
        "timeoutMs": 300000,
        "initialCredit": 0,
        "params": {
          "services": [
            "0000180d-0000-1000-8000-00805f9b34fb"
          ]
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceResponse",
        "id": 3,
        "result": {
          "device": {
            "id": "dev-1"
          }
        }
      }
    }
  ]
}
