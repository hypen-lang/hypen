{
  "name": "core-capabilities-reopen",
  "description": "Planned reopening of the connection-owned core.capabilities stream before its finite deadline: the server replenishes snapshot credit independently of app handlers, then retires the old stream (cancel) before opening a new one under a new id. The new stream's first event is a fresh full snapshot; the old stream's late snapshot and terminal are ignored.",
  "protocol": 1,
  "steps": [
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 1,
        "capability": "core.capabilities",
        "version": 1,
        "owner": {
          "connection": true
        },
        "lifetime": "connection",
        "timeoutMs": 86400000,
        "initialCredit": 1,
        "params": {}
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceEvent",
        "id": 1,
        "control": {
          "renewLease": 1
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 1,
        "control": {
          "leaseAck": 1
        }
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 1,
        "event": {
          "capabilities": [
            {
              "name": "core.capabilities",
              "versions": [
                1
              ]
            },
            {
              "name": "gallery.pick",
              "versions": [
                1
              ]
            }
          ]
        }
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceEvent",
        "id": 1,
        "control": {
          "grant": 1
        }
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceEvent",
        "id": 1,
        "control": {
          "cancel": true
        }
      }
    },
    {
      "dir": "s2c",
      "message": {
        "type": "deviceRequest",
        "id": 2,
        "capability": "core.capabilities",
        "version": 1,
        "owner": {
          "connection": true
        },
        "lifetime": "connection",
        "timeoutMs": 86400000,
        "initialCredit": 8,
        "params": {}
      }
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 1,
        "event": {
          "capabilities": [
            {
              "name": "core.capabilities",
              "versions": [
                1
              ]
            }
          ]
        }
      },
      "ignored": true
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceResponse",
        "id": 1,
        "error": {
          "code": "cancelled"
        }
      },
      "ignored": true
    },
    {
      "dir": "c2s",
      "message": {
        "type": "deviceEvent",
        "id": 2,
        "event": {
          "capabilities": [
            {
              "name": "core.capabilities",
              "versions": [
                1
              ]
            },
            {
              "name": "gallery.pick",
              "versions": [
                1
              ]
            },
            {
              "name": "permission.query",
              "versions": [
                1
              ]
            }
          ]
        }
      }
    }
  ]
}
