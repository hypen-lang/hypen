    {
      "description": "Initial render materializes the first window",
      "action": "initialRender",
      "expectedPatches": [
        {
          "type": "create",
          "elementType": "List"
        },
        {
          "type": "setProp",
          "name": "__virt.window",
          "value": {
            "total": 50,
            "start": 0,
            "end": 5
          }
        }
      ],
      "allowExtraPatches": true
    },
    {
      "description": "A viewport report moves the window: rows leave without exit transitions",
      "action": "setViewport",
      "viewport": {
        "elementType": "List",
        "start": 20,
        "end": 30
      },
      "expectedPatches": [
        {
          "type": "remove",
          "transition": false
        },
        {
          "type": "setProp",
          "name": "__virt.window",
          "value": {
            "total": 50,
            "start": 20,
            "end": 30
          }
        }
      ],
      "allowExtraPatches": true
    },
    {
      "description": "Reporting the same range again is a no-op",
      "action": "setViewport",
      "viewport": {
        "elementType": "List",
        "start": 20,
        "end": 30
      },
      "expectedPatchCount": 0
    },
