  "steps": [
    {
      "description": "Initial render materializes rows 0..5",
      "action": "initialRender",
      "expectedPatches": [
        {
          "type": "create",
          "elementType": "List"
        },
        {
          "type": "setProp",
          "name": "__virt.window",
          "value": {
            "total": 50,
            "start": 0,
            "end": 5
          }
        }
      ],
      "allowExtraPatches": true
    },
    {
      "description": "An overlapping window (2..7) evicts rows 0 and 1 with plain removes",
      "action": "setViewport",
      "viewport": {
        "elementType": "List",
        "start": 2,
        "end": 7
      },
      "expectedPatches": [
        {
          "type": "remove",
          "transition": false
        },
        {
          "type": "remove",
          "transition": false
        },
        {
          "type": "setProp",
          "name": "__virt.window",
          "value": {
            "total": 50,
            "start": 2,
            "end": 7
          }
        }
      ],
      "allowExtraPatches": true,
      "forbiddenPatchTypes": [
        "clearChildren"
      ]
    },
    {
      "description": "A window clear of every materialized row (30..35) clears the List once, before the new rows",
      "action": "setViewport",
      "viewport": {
        "elementType": "List",
        "start": 30,
        "end": 35
      },
      "expectedPatchTypes": [
        "clearChildren",
        "create",
        "insert",
        "create",
        "insert",
        "create",
        "insert",
        "create",
        "insert",
        "create",
        "insert",
        "setProp"
      ],
      "expectedPatches": [
        {
          "type": "clearChildren",
          "target": {
            "elementType": "List"
          }
        },
        {
          "type": "setProp",
          "name": "__virt.window",
          "value": {
            "total": 50,
            "start": 30,
            "end": 35
          }
        },
        {
          "type": "create",
          "elementType": "Text",
          "props": {
            "0": "row 30"
          }
        }
      ],
      "allowExtraPatches": true,
      "forbiddenPatchTypes": [
        "remove"
      ]
    }
