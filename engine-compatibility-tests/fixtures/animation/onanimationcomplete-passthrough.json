{
  "$schema": "../../schema/test-case.schema.json",
  "name": "onanimationcomplete-passthrough",
  "description": ".onAnimationComplete(@actions.name) is an ordinary event applicator: the anim interception does NOT swallow it, so it reaches the create patch as the resolved onAnimationComplete.0 action prop alongside the sibling .animate's __anim.animate channel. Renderers own dispatch — the engine never lowers it into an __anim.* channel",
  "category": "animation",
  "priority": "P0",

  "skip": {
    "reason": "animation protocol not yet implemented",
    "sdks": ["golang"]
  },

  "input": {
    "source": "Box().animate(pulse).onAnimationComplete(@actions.animationDone)",
    "initialState": {},
    "module": {
      "name": "TestModule",
      "actions": [],
      "stateKeys": []
    }
  },

  "expected": {
    "patchCount": 2,
    "patchTypes": ["create", "insert"],
    "patches": [
      {
        "type": "create",
        "elementType": "Box",
        "props": {
          "onAnimationComplete.0": "@animationDone",
          "__anim.animate": {
            "curve": "easeInOut",
            "duration": 1200,
            "preset": "pulse",
            "repeat": "loop"
          }
        },
        "absentProps": ["__anim.onAnimationComplete"]
      },
      { "type": "insert" }
    ]
  }
}
