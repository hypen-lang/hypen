{
  "$schema": "../../schema/test-case.schema.json",
  "name": "foreach-exit-remove",
  "description": "Shrinking a keyed ForEach list flags the removed item root that carries __anim.exit with transition:true; surviving rows are reused (no Remove/Create churn)",
  "category": "animation",
  "priority": "P1",

  "skip": {
    "reason": "animation protocol not yet implemented (golang); ForEach source rendering not supported in the typescript runner",
    "sdks": ["golang", "typescript"]
  },

  "input": {
    "source": "Column { ForEach(items: \"@{state.items}\") { Text(\"@{item.name}\", key: \"@{item.id}\").exit(fade) } }",
    "initialState": {
      "items": [
        { "id": "a", "name": "Alice" },
        { "id": "b", "name": "Bob" }
      ]
    },
    "module": {
      "name": "TestModule",
      "actions": [],
      "stateKeys": ["items"]
    }
  },

  "steps": [
    {
      "description": "Initial render creates both items with __anim.exit",
      "action": "initialRender",
      "expectedPatchCount": 6,
      "expectedPatchTypes": ["create", "insert", "create", "insert", "create", "insert"],
      "expectedPatches": [
        { "type": "create", "elementType": "Column", "props": {} },
        {
          "type": "create",
          "elementType": "Text",
          "props": {
            "0": "Alice",
            "__anim.exit": { "curve": "easeIn", "duration": 150, "presets": ["fade"] },
            "key": "a"
          }
        },
        {
          "type": "create",
          "elementType": "Text",
          "props": {
            "0": "Bob",
            "__anim.exit": { "curve": "easeIn", "duration": 150, "presets": ["fade"] },
            "key": "b"
          }
        },
        { "type": "insert" },
        { "type": "insert" },
        { "type": "insert" }
      ]
    },
    {
      "description": "Dropping Bob retires exactly Bob's row with a transition-flagged Remove; Alice keeps her node",
      "action": "updateState",
      "stateChange": {
        "paths": ["items"],
        "newValues": {
          "items": [{ "id": "a", "name": "Alice" }]
        }
      },
      "expectedPatchCount": 1,
      "expectedPatchTypes": ["remove"],
      "forbiddenPatchTypes": ["create"],
      "expectedPatches": [{ "type": "remove", "transition": true }]
    }
  ]
}
