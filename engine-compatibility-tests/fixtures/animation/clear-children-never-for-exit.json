{
  "$schema": "../../schema/test-case.schema.json",
  "name": "clear-children-never-for-exit",
  "description": "Rows carrying an exit transition (.exit) are never cleared: emptying the list sends remove { transition: true } per row so renderers can play each exit",
  "category": "animation",
  "priority": "P1",
  "input": {
    "source": "List(@state.items, key: \"id\", lazy: false) { Text(\"@{item.name}\").exit(fade) }",
    "initialState": {
      "items": [
        {
          "id": 0,
          "name": "row 0"
        },
        {
          "id": 1,
          "name": "row 1"
        },
        {
          "id": 2,
          "name": "row 2"
        }
      ]
    },
    "module": {
      "name": "ClearChildrenModule",
      "actions": [],
      "stateKeys": [
        "items"
      ]
    }
  },
  "steps": [
    {
      "description": "Initial render",
      "action": "initialRender",
      "expectedPatches": [
        {
          "type": "create",
          "elementType": "List"
        }
      ],
      "allowExtraPatches": true
    },
    {
      "description": "Emptying the list flags every row's exit and clears nothing",
      "action": "updateState",
      "stateChange": {
        "paths": [
          "items"
        ],
        "newValues": {
          "items": []
        }
      },
      "expectedPatches": [
        {
          "type": "remove",
          "transition": true
        },
        {
          "type": "remove",
          "transition": true
        },
        {
          "type": "remove",
          "transition": true
        }
      ],
      "allowExtraPatches": true,
      "forbiddenPatchTypes": [
        "clearChildren"
      ]
    }
  ]
}
