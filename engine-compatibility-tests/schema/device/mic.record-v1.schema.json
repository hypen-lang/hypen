{
  "$defs": {
    "blobItem": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 67108864,
          "minimum": 0,
          "type": "integer"
        },
        "channel": {
          "maximum": 0,
          "minimum": 0,
          "type": "integer"
        },
        "contentType": {
          "maxLength": 256,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "contentType",
        "bytes",
        "sha256"
      ],
      "type": "object"
    },
    "blobStart": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 67108864,
          "minimum": 0,
          "type": "integer"
        },
        "channel": {
          "maximum": 0,
          "minimum": 0,
          "type": "integer"
        },
        "contentType": {
          "maxLength": 256,
          "type": "string"
        },
        "kind": {
          "const": "blobStart"
        }
      },
      "required": [
        "kind",
        "channel",
        "contentType"
      ],
      "type": "object"
    },
    "event": {
      "oneOf": [
        {
          "$ref": "#/$defs/blobStart"
        },
        {
          "$ref": "#/$defs/progress"
        }
      ]
    },
    "params": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "maximum": 2,
          "minimum": 1,
          "type": "integer"
        },
        "format": {
          "enum": [
            "pcm16"
          ],
          "type": "string"
        },
        "maxDurationMs": {
          "maximum": 600000,
          "minimum": 1,
          "type": "integer"
        },
        "sampleRate": {
          "maximum": 192000,
          "minimum": 8000,
          "type": "integer"
        }
      },
      "required": [
        "sampleRate",
        "format"
      ],
      "type": "object"
    },
    "progress": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "progress"
        },
        "state": {
          "enum": [
            "pendingConsent",
            "running"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "state"
      ],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "durationMs": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "item": {
          "$ref": "#/$defs/blobItem"
        }
      },
      "required": [
        "durationMs",
        "item"
      ],
      "type": "object"
    }
  },
  "$id": "https://hypen.space/schemas/device/mic.record-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/params"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "description": "Provisional (RFC 001 §6): may change until the Phase 4 real-driver gate; after stabilization an optional addition creates a new revision. Bounds come from this revision's registry entry (registry-v1.json). Validate a payload against #/$defs/params, #/$defs/result or #/$defs/event; the document root only accepts a value matching any of them.",
  "title": "mic.record capability, revision 1"
}
