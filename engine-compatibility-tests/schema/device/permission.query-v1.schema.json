{
  "$defs": {
    "event": {
      "$ref": "#/$defs/progress"
    },
    "params": {
      "additionalProperties": false,
      "properties": {
        "permission": {
          "enum": [
            "camera",
            "microphone",
            "photos",
            "location",
            "notifications",
            "bluetooth",
            "contacts"
          ],
          "type": "string"
        }
      },
      "required": [
        "permission"
      ],
      "type": "object"
    },
    "progress": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "progress"
        },
        "state": {
          "enum": [
            "pendingConsent",
            "running"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "state"
      ],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "granted",
            "denied",
            "prompt"
          ],
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    }
  },
  "$id": "https://hypen.space/schemas/device/permission.query-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/params"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "description": "Provisional (RFC 001 §6): may change until the Phase 4 real-driver gate; after stabilization an optional addition creates a new revision. Bounds come from this revision's registry entry (registry-v1.json). Validate a payload against #/$defs/params, #/$defs/result or #/$defs/event; the document root only accepts a value matching any of them.",
  "title": "permission.query capability, revision 1"
}
