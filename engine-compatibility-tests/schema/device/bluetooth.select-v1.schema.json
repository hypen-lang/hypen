{
  "$defs": {
    "event": {
      "$ref": "#/$defs/progress"
    },
    "params": {
      "additionalProperties": false,
      "properties": {
        "namePrefix": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "services": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [],
      "type": "object"
    },
    "progress": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "progress"
        },
        "state": {
          "enum": [
            "pendingConsent",
            "running"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "state"
      ],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "name": {
              "maxLength": 256,
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "type": "object"
        }
      },
      "required": [
        "device"
      ],
      "type": "object"
    }
  },
  "$id": "https://hypen.space/schemas/device/bluetooth.select-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/params"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "description": "Provisional (RFC 001 §6): may change until the Phase 4 real-driver gate; after stabilization an optional addition creates a new revision. Bounds come from this revision's registry entry (registry-v1.json). Validate a payload against #/$defs/params, #/$defs/result or #/$defs/event; the document root only accepts a value matching any of them.",
  "title": "bluetooth.select capability, revision 1"
}
