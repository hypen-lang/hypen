// Module example with state
module Counter(initialValue: 0) {
  Column {
    Text("Count: @{state.count}")
      .fontSize(32)
      .fontWeight("bold")
      .marginBottom(16)

    Row {
      Button {
        Text("-")
      }
        .onClick(@actions.decrement)
        .padding(16)
        .backgroundColor("red")
        .borderRadius(8)
        .marginRight(8)

      Button {
        Text("+")
      }
        .onClick(@actions.increment)
        .padding(16)
        .backgroundColor("green")
        .borderRadius(8)
    }
      .horizontalAlignment("center")
  }
    .horizontalAlignment("center")
    .padding(32)
}
