{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Hypen",
  "scopeName": "source.hypen",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#component-declaration" },
    { "include": "#applicators" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#references" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.hypen",
          "match": "//.*$"
        },
        {
          "name": "comment.block.hypen",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.hypen",
          "match": "\\b(module|component|import|from)\\b"
        },
        {
          "name": "constant.language.boolean.hypen",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "component-declaration": {
      "patterns": [
        {
          "name": "meta.component.hypen",
          "match": "\\b([A-Z][a-zA-Z0-9]*)\\b",
          "captures": {
            "1": {
              "name": "entity.name.type.component.hypen"
            }
          }
        }
      ]
    },
    "applicators": {
      "patterns": [
        {
          "name": "meta.applicator.hypen",
          "match": "\\.(\\w+)(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.applicator.hypen"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.hypen",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.hypen",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.expression.hypen",
              "begin": "@\\{",
              "end": "\\}",
              "patterns": [
                { "include": "#references" },
                { "include": "#operators" },
                { "include": "#strings" },
                { "include": "#numbers" },
                { "include": "#booleans" }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hypen",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.hypen",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "references": {
      "patterns": [
        {
          "name": "variable.other.reference.hypen",
          "match": "@(\\w+(?:\\.\\w+)*)",
          "captures": {
            "0": {
              "name": "variable.other.reference.hypen"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.hypen",
          "match": "[+\\-*/%=<>!&|?:]"
        }
      ]
    }
  }
}


