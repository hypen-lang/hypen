// Hypen cross-module state capability — v0.1.0 (strawman)
//
// The WASM translation of today's `HypenGlobalContext`. Lets one module read a
// sibling's state and dispatch actions to it — but only as granted by the
// reading module's manifest (`reads` / `dispatches`). Enforced by the host at
// call time.
//
// Design choices:
//   - `read` is direct + synchronous: the engine already holds every module's
//     state, so a snapshot is cheap. This is the consistent, widely-used
//     primitive across all of today's SDKs.
//   - `dispatch` is *directed*, not broadcast. It replaces both the TS
//     `context.emit()` workaround and the Swift/Kotlin
//     `ModuleReference.dispatchAction()` with one primitive. Cross-module
//     *writes* always go through the target's reducer — no module ever holds
//     a writable handle to another's state.
//
// `action` is declared locally (rather than reusing `hypen:module/types`) so
// this package stays a leaf dependency — `hypen:module` imports it, not the
// other way around, avoiding a circular package reference.

package hypen:engine@0.1.0;

interface state {
    /// An action to deliver to a sibling module's reducer.
    record action {
        /// Action name owned by the target module.
        name: string,
        /// JSON payload bytes.
        payload: list<u8>,
    }

    variant error {
        /// No module registered under that name.
        not-found,
        /// Caller's manifest doesn't grant this access. Payload names the
        /// missing grant ("reads" / "dispatches").
        permission-denied(string),
        /// The target module's reducer returned an error.
        module-error(string),
    }

    /// Snapshot of a sibling module's current state as JSON bytes. Requires the
    /// target to be listed in this module's manifest `reads`.
    read: func(module: string) -> result<list<u8>, error>;

    /// Send an action to a sibling module's reducer. Requires the target to be
    /// listed in this module's manifest `dispatches`. The dispatch is applied
    /// after the current reducer returns (no reentrancy).
    dispatch: func(module: string, action: action) -> result<_, error>;
}
