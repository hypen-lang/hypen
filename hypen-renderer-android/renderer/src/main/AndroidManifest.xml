<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Device Capability Protocol (RFC 001). The library declares no
      permissions: an app adds what it enables (see AndroidDeviceHost).
      camera.capture hands the system capture app a private temp file through
      this provider (write access granted per capture intent, not exported).
      The FILE_PROVIDER_PATHS meta-data is required: the static
      FileProvider.getUriForFile() that builds the capture URI reads the paths
      only from it (the provider's constructor argument serves the provider
      instance alone); without it every camera.capture failed before the
      camera app was launched.
    -->
    <application>
        <provider
            android:name="space.hypen.renderer.device.android.HypenDeviceFileProvider"
            android:authorities="${applicationId}.hypen.device.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/hypen_device_file_paths" />
        </provider>
    </application>

</manifest>
