# Dependencies
node_modules/
package-lock.json
yarn.lock

# Build outputs
target/
dist/
out/
pkg/
*.tgz
hypen-renderer-swift/Gallery/build/

# Compiled binaries
examples/social/go/social

# Swift / Xcode build artifacts
.build/
DerivedData/
*.swiftdeps
**/*.o
**/*.d
**/xcuserdata/
**/*.xcuserstate
**/.swiftpm/xcode/xcuserdata/

# WASM artifacts (built from source)
*.wasm
# Allow committed WASM binaries needed by SDKs
!hypen-web/packages/server/wasm-node/*.wasm
!hypen-web/packages/web-engine/wasm-browser/*.wasm
!hypen-golang/hypen_engine.wasm

# Rust
# Root Cargo.lock is committed for reproducible builds
# Sub-crate lock files are not needed with workspace
parser/Cargo.lock
**/*.rs.bk

# Code coverage
coverage/
*.lcov

# Logs
logs/
*.log

# Environment files
.env
.env.*
!.env.example

# npm configuration (may contain auth tokens)
.npmrc

# Caches
.cache/
.eslintcache
*.tsbuildinfo

# Gradle local properties (contains publishing secrets)
**/local.properties
**/gradle-local.properties

# IDE/Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code local settings (machine-specific paths)
**/.claude/settings.json
**/.claude/settings.local.json
**/.claude/projects/

# Agent skills (local dev tooling, not project content)
.agents/

# OS
.DS_Store
Thumbs.db

# mrq local config
.mrq.json

# Hypen generated directories (auto-generated by hypen dev/generate)
**/.hypen/

# Wrangler
.wrangler/

.vercel
.gstack/
