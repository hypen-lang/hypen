{
  "name": "@hypen-space/cf",
  "version": "0.5.3",
  "description": "Hypen Cloudflare Workers SDK — HypenDurableObject, CFEngine, defineHypenWorker",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker-entry.d.ts",
      "import": "./src/worker-entry.ts",
      "default": "./src/worker-entry.ts"
    },
    "./client": "./dist/client/generic.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "build:client": "bun build client/generic-client.ts --outdir dist/client --target browser --minify --entry-naming generic.js",
    "build:types": "tsc --emitDeclarationOnly",
    "prepublishOnly": "bun run build",
    "typecheck": "bunx tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hypen-space/core": "^0.5.3",
    "@hypen-space/web": "^0.5.3"
  },
  "peerDependencies": {
    "hypen-engine": "*"
  },
  "peerDependenciesMeta": {
    "hypen-engine": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "keywords": [
    "hypen",
    "cloudflare",
    "workers",
    "durable-objects",
    "wasm"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Hypen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hypen-lang/hypen.git",
    "directory": "hypen-web/packages/cf"
  }
}
