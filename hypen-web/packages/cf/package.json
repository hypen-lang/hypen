{
  "name": "@hypen-space/cf",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker-entry.ts"
  },
  "scripts": {
