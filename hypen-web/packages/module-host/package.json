{
  "name": "@hypen-space/module-host",
  "version": "0.6.7",
  "description": "Hypen module host - browser/Node/Bun host for Hypen WASM Component modules (runtime jco bindgen, link-time capability gating, scoped storage, deferred HTTP) driven by the engine's BridgedHost",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./js-module-host": {
      "types": "./dist/js-module-host.d.ts",
      "bun": "./src/js-module-host.ts",
      "import": "./dist/js-module-host.js",
      "default": "./dist/js-module-host.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "bun": "./src/storage.ts",
      "import": "./dist/storage.js",
      "default": "./dist/storage.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "bun": "./src/http.ts",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "bun": "./src/types.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:browser": "bun run build && bun tests/browser/run.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bytecodealliance/jco-transpile": "^0.24.0",
    "@bytecodealliance/preview2-shim": "^0.31.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "keywords": [
    "hypen",
    "wasm",
    "component-model",
    "wasi",
    "jco",
    "module-host"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "author": "Hypen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hypen-lang/hypen.git",
    "directory": "hypen-web/packages/module-host"
  },
  "publishConfig": {
    "access": "public"
  }
}
