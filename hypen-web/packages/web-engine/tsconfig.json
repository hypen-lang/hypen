{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "baseUrl": ".",
    "paths": {
      "@hypen-space/core": ["../core/src/index.ts"],
      // Non-standard export: see root tsconfig.json for rationale.
      "@hypen-space/core/components": ["../core/src/components/builtin.ts"],
      "@hypen-space/core/*": ["../core/src/*"],
      "@hypen-space/web": ["../web/src/index.ts"],
      "@hypen-space/web/*": ["../web/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
