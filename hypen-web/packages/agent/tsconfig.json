{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // No rootDir in the dev typecheck config — see server/tsconfig.json.
    "paths": {
      "@hypen-space/core": ["../core/src/index.ts"],
      // Non-standard export: see root tsconfig.json for rationale.
      "@hypen-space/core/components": ["../core/src/components/builtin.ts"],
      "@hypen-space/core/*": ["../core/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
