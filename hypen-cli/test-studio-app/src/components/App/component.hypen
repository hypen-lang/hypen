import Header from "../cool/header.hypen"

module App {
  Column {
    Text("Hypen Counter")
      .fontSize("24pt")
      .fontWeight("bold")
      .color("#333")

    Text("Count: @{state.count}")
      .fontSize("100dp")
      .fontWeight("bold")
      .color("#007bff")

    Row {
      Button {
        Text("-A")      .fontSize(99)

      }
      .onClick("@actions.decrement")
      .padding("16sp")

      Button {
        Text("+")
      }
      .onClick("@actions.increment")
      .padding(16)
      .fontSize(24)
    }
    .gap(16)
  }
  .padding(32)
  .gap(24)
  .horizontalAlignment("center")
  .fillMaxSize()
}
