{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun-types"],
    "baseUrl": ".",
    "paths": {
      "@hypen-space/core": ["../hypen-web/packages/core/src/index.ts"],
      "@hypen-space/core/*": ["../hypen-web/packages/core/src/*.ts"],
      "@hypen-space/server": ["../hypen-web/packages/server/src/index.ts"],
      "@hypen-space/server/remote": ["../hypen-web/packages/server/src/remote/server.ts"],
      "@hypen-space/server/*": ["../hypen-web/packages/server/src/*.ts"],
      "@hypen-space/web": ["../hypen-web/packages/web/src/index.ts"],
      "@hypen-space/web/*": ["../hypen-web/packages/web/src/*.ts"],
      "@hypen-space/web-engine": ["../hypen-web/packages/web-engine/src/index.ts"],
      "@hypen-space/web-engine/*": ["../hypen-web/packages/web-engine/src/*.ts"]
    }
  },
  "include": ["src/**/*", "bin/**/*"]
}
