{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hypen-news",
  "main": "src/worker.ts",
  "compatibility_date": "2025-05-01",
  // nodejs_compat provides AsyncLocalStorage (node:async_hooks), which scopes
  // module handlers to their visitor's Durable Object (src/scope.ts).
  "compatibility_flags": ["nodejs_compat"],

  // `wrangler dev` port for the home-screen launcher (ws://localhost:8800/ws).
  "dev": { "port": 8800, "inspector_port": 9242 },

  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false },
    { "type": "Text", "globs": ["**/dist/client/*.js"], "fallthrough": true }
  ],

  "durable_objects": {
    "bindings": [
      // One per visitor: the Hypen sessions + saved stories / read history.
      { "name": "NEWS_DO", "class_name": "NewsDO" },
      // One shared instance ("hub"): upstream polling + response cache.
      { "name": "NEWS_HUB", "class_name": "NewsHub" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NewsDO", "NewsHub"] }
  ],

  "observability": {
    "enabled": true
  }
}
