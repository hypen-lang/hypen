{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hypen-photos",
  "main": "src/worker.ts",
  "compatibility_date": "2025-05-01",
  // `no_web_socket_compression`: since the 2023-08-15 compatibility date
  // workerd negotiates permessage-deflate WITH context takeover, and a socket
  // compressed that way stays UI-only (RFC 001 §2.3) — no device plane, so no
  // camera, imports or downloads. Frames go uncompressed instead.
  "compatibility_flags": ["nodejs_compat", "no_web_socket_compression"],

  // This example's slot in the examples port map (README.md).
  "dev": {
    "port": 8797,
    "inspector_port": 9239
  },

  // The Hypen WASM engine is pulled in as a CompiledWasm module — this rule is
  // what lets the engine boot inside a Worker.
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false },
    { "type": "Text", "globs": ["**/dist/client/*.js"], "fallthrough": true }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "PHOTOS_DO", "class_name": "PhotosDO" }
    ]
  },

  // Photo bytes (metadata lives in each visitor's Durable Object SQLite).
  // `wrangler dev` emulates the bucket under .wrangler/state; before the first
  // deploy create it once: `bunx wrangler r2 bucket create hypen-photos`.
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "hypen-photos" }
  ],

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PhotosDO"] }
  ]
}
