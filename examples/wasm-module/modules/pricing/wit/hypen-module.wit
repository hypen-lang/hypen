// Hypen Module world — v0.1.0 (strawman)
//
// Defines what every Hypen module *exports* (the reducer ABI) and what
// capabilities it can *import*. A module compiled to a WASM Component
// implementing this world is portable across every Hypen host:
// web (via jco), iOS (WasmKit / AOT), Android (wasmtime via JNI), desktop
// (wasmtime), and the server (any WASI host).
//
// Design notes:
//
// 1. State lives in the engine's memory; modules receive it as an argument
//    on every dispatch and return new state (or `none` for no change). The
//    engine path-tracks the parsed JSON for reactivity (`portable/diff.rs`).
//    When/if perf demands it in v0.2, swap the `json` alias for a structured
//    `value` variant without changing the module surface.
//
// 2. `dispatch` is a pure reducer: `(state, action) -> (state-delta, effects)`.
//    All async side-effects (network, navigation, dispatching follow-up
//    actions) go through effect descriptors that the host performs and
//    dispatches results back as new actions (Elm-style). Direct async
//    capability imports get added in v0.2 when Component Model preview 3
//    lands — without invalidating existing modules.
//
// 3. Storage is the only direct capability import in v0.1 because reads
//    are fast and lookup-shaped, so they don't need the effect-descriptor
//    round-trip.

package hypen:module@0.1.0;

interface types {
    /// UTF-8 JSON bytes. Engine parses on receipt and path-tracks for
    /// reactivity. Modules can write whatever JSON shape they want; engine
    /// only cares that paths are stable across snapshots.
    type json = list<u8>;

    /// An action raised by the UI (`@actions.<name>` in the DSL) or emitted
    /// by another action's `reducer-output.emit`.
    record action {
        /// Matches `@actions.<name>` in the DSL. Globally namespaced within
        /// the module (the engine resolves which module owns it before
        /// dispatch).
        name: string,
        /// JSON payload carrying action arguments. Empty `{}` is common.
        payload: json,
    }

    /// What `dispatch`, `on-activated`, and `on-deactivated` return.
    /// All three fields are optional in spirit: a no-op response is
    /// `{ state: none, effects: [], emit: [] }`.
    record reducer-output {
        /// `some(new-state)` → engine path-diffs against the previous snapshot,
        /// marks dependent IR nodes dirty, re-renders affected subtrees.
        /// `none`            → action didn't change state; engine no-ops the
        /// reactivity path entirely.
        state: option<json>,
        /// Side effects the host performs on the module's behalf. Each
        /// effect's result is dispatched back as a follow-up action.
        effects: list<effect>,
        /// Additional actions the engine should enqueue *after* this one
        /// completes. Lets modules express sagas / cascading behaviour
        /// without a global action bus. Order is preserved.
        emit: list<action>,
    }

    /// Side effects the host performs on the module's behalf.
    ///
    /// In v0.1 these are the only non-storage effects. HTTP is not on this
    /// list — modules import `wasi:http/outgoing-handler` directly through
    /// the `module-x` world below, so they can use idiomatic per-language
    /// HTTP clients (Rust `reqwest`/`waki`, Go `net/http`, etc.) instead of
    /// going through a Hypen-shaped descriptor.
    variant effect {
        /// Sleep for N ms, then dispatch an action. Used for debounce,
        /// retry backoff, animation timing.
        delay(delay-effect),
        /// Navigate via the host's `HypenRouter`. Payload is the route
        /// path (e.g. `/profile/42`).
        navigate(string),
        /// Emit a structured log entry. Host decides where it goes
        /// (stdout, console, logcat, OS log).
        log(log-effect),
    }

    /// A delayed action dispatch.
    record delay-effect {
        /// Wall-clock milliseconds to wait before dispatching `then`.
        /// Host may round up; high-precision timing is not guaranteed.
        ms: u32,
        /// Action name to dispatch when the delay elapses. Payload is
        /// the empty JSON object.
        then: string,
    }

    /// A structured log entry.
    record log-effect {
        level: log-level,
        message: string,
    }

    /// Standard log severities. Matches the levels in `crate::logger`
    /// on the engine side.
    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }
}

// -----------------------------------------------------------------------------
// The module world. Every Hypen module is a WASM Component implementing this.
// -----------------------------------------------------------------------------

/// The contract every Hypen module satisfies. Exports define the reducer
/// + lifecycle ABI the engine drives. Imports define the host capabilities
/// the module can rely on at runtime.
world module {
    use types.{action, reducer-output, json};

    /// Construct the initial state snapshot.
    ///
    /// Called once per module *instance* when it's first created. `config`
    /// comes from the module's instantiation in the DSL — e.g. given
    /// `module ProfilePage(userId: 123)`, config carries `{"userId": 123}`.
    ///
    /// Not called on re-entry from the Router subtree cache or after a
    /// rehydration — those go straight to `on-activated` with the engine's
    /// cached state. See `wit/ENGINE_INTEGRATION.md` "Lifecycle integration".
    export init: func(config: json) -> result<json, string>;

    /// The reducer. Receives the current state and the action being
    /// dispatched; returns whatever changed. Pure: no I/O outside the
    /// declared capability imports.
    export dispatch: func(state: json, action: action) -> result<reducer-output, string>;

    /// Module became visible (route entered or cache hit). State is whatever
    /// the engine has cached from the last `dispatch` / `init`. Returning
    /// effects here is how modules express "do X when I come back" without
    /// needing a synthetic action.
    export on-activated: func(state: json) -> result<reducer-output, string>;

    /// Module is leaving the screen. Engine still keeps it cached unless
    /// the Router cache evicts. Returning a state delta here is allowed
    /// (e.g. to record a "last seen" timestamp).
    export on-deactivated: func(state: json) -> result<reducer-output, string>;

    /// Final teardown. Engine calls this just before dropping the module
    /// instance's WASM linear memory. Last chance to flush anything that
    /// needs to be persisted explicitly (most things should already be in
    /// `hypen:storage/*`).
    export on-destroyed: func(state: json) -> result<_, string>;

    /// Names of actions this module's `dispatch` accepts. The host calls
    /// this once after instantiation and wires up action routing from the
    /// result — so a host operator never has to declare the action list
    /// out-of-band (no `--actions` flag, no manifest duplication). The
    /// module is the single source of truth for what it handles.
    ///
    /// An empty list means a read-only module (no actions). A list
    /// containing the wildcard `"*"` means "route every action name to
    /// `dispatch` and let it sort them out" — for modules that dispatch
    /// dynamically. Most modules return a static list of literal names.
    export actions: func() -> list<string>;

    // Capability imports.
    //
    // `local` is always available. `app` and `cloud` require manifest grants
    // and will fail instantiation if requested without grants.
    import hypen:storage/local@0.1.0;
    import hypen:storage/app@0.1.0;
    import hypen:storage/cloud@0.1.0;
}

/// Extended world for modules that participate in cross-module state. A
/// superset of `module`: same reducer + lifecycle exports, plus the
/// `hypen:engine/state` capability for reading/dispatching to siblings.
///
/// Kept separate from `module` so the base world (and its hosts — e.g. the
/// browser jco spike) stay unaffected. A host linker built for `module-x`
/// can still instantiate a plain `module` component, since the extra import
/// is simply unused.
///
/// HTTP is *not* declared in this WIT. Modules use `wasi:http/outgoing-handler`
/// directly (via their per-language wit-bindgen), the same way they use
/// `wasi:io` for streams — the standard WASI surface is between the module
/// and the runtime, not part of the Hypen contract. Hosts implementing
/// `module-x` are expected to link `wasi:http`. (`WasmtimeHost` does so
/// via `wasmtime-wasi-http`.)
world module-x {
    include module;
    import hypen:engine/state@0.1.0;
}
