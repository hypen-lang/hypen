Button {
    Row {
        Stack {
            Image(src: "@{item.imageUrl}")
                .width(96)
                .height(96)
                .objectFit("cover")
                .tw("rounded-lg bg-gray-100")

            // Stack aligns content top-start by default; a margin nudges the
            // badge off the image corner.
            If(condition: "@{!item.isOpen}") {
                Column {
                    Text("Closed")
                        .tw("text-[10px] font-bold text-white px-1.5 py-0.5 bg-gray-800 rounded")
                }
                .tw("m-1")
            }
        }

        Column {
            Row {
                Text("@{item.name}")
                    .tw("text-base font-bold flex-1")

                Row {
                    Icon(@resources.star)
                        .size(14)
                        .color("#f59e0b")
                    Text("@{item.rating}")
                        .tw("text-sm font-semibold ml-1")
                }
                .tw("items-center shrink-0")
            }
            .tw("items-center")

            Text("@{item.cuisine}")
                .tw("text-sm text-gray-500 mt-0.5")

            Row {
                Row {
                    Icon(@resources.clock)
                        .size(12)
                        .color("#6b7280")
                    Text("@{item.deliveryTimeMin}-@{item.deliveryTimeMax} min")
                        .tw("text-xs text-gray-600 ml-1")
                }
                .tw("items-center")

                Text(" · ")
                    .tw("text-xs text-gray-400 px-1")

                Row {
                    Icon(@resources.map-pin)
                        .size(12)
                        .color("#6b7280")
                    Text("@{item.distanceKm} km")
                        .tw("text-xs text-gray-600 ml-1")
                }
                .tw("items-center")
            }
            .tw("mt-1 items-center")

            Row {
                Text("@{item.deliveryFee == 0 ? 'Free delivery' : '$' + item.deliveryFee + ' delivery'}")
                    .tw("text-[11px] font-semibold text-orange-600")
            }
            .tw("mt-1.5")
        }
        .tw("flex-1 pl-3 justify-center")
    }
    .tw("bg-white rounded-xl p-3 items-center w-full")
}
.tw("bg-transparent border-0 p-0 mb-3 w-full")
.onClick(@router.push, to: "/restaurant/@{item.id}")
