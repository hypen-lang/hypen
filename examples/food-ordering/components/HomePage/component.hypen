Column {
    Column {
        Row {
            Column {
                Text("Deliver to")
                    .tw("text-xs text-gray-500")
                Row {
                    Icon(@resources.map-pin)
                        .size(14)
                        .color("#f97316")
                    Text("@{state.currentUser.address}")
                        .tw("text-sm font-semibold ml-1 truncate max-w-64")
                }
                .tw("items-center mt-0.5")
            }
            .tw("flex-1")

            Button {
                Image(src: "@{state.currentUser.avatarUrl}")
                    .tw("w-10 h-10 rounded-full")
            }
            .tw("bg-transparent border-0 p-0 shrink-0")
            .onClick(@router.push, to: "/profile")
        }
        .tw("items-center")

        Button {
            Row {
                Icon(@resources.search)
                    .size(18)
                    .color("#9ca3af")
                Text("Search for restaurants or dishes")
                    .tw("text-sm text-gray-400 ml-2")
            }
            .tw("items-center")
        }
        .tw("bg-white rounded-xl border border-gray-200 px-4 py-3 mt-4 w-full")
        .onClick(@router.push, to: "/search")
    }
    .tw("px-4 pt-4 pb-2 bg-white border-b border-gray-100")

    Column {
        Text("Categories")
            .tw("text-base font-bold px-4 pt-4")

        Row {
            ForEach(items: @state.categories, key: "id") {
                CategoryChip()
            }
        }
        .tw("flex-row gap-2 px-4 py-3")
        .scrollable("horizontal")
    }

    Row {
        Icon(@resources.fire)
            .size(18)
            .color("#f97316")
        Text("Popular near you")
            .tw("text-base font-bold ml-2")
    }
    .tw("px-4 pt-2 pb-2 items-center")

    Grid(@state.restaurants, key: "id") {
        RestaurantCard()
    }
    .gridColumns({default: 1, sm: 2, md: 3, lg: 4, xl: 5})
    .gap(18)
    .tw("px-4 pb-4 w-full")
}
.scrollable(true)
.tw("flex-1 w-full bg-gray-50")
