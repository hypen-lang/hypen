{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hypen-food-ordering",
  "main": "src/worker.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],

  "alias": {
    "@hypen-space/core": "../../../hypen-web/packages/core/src/index.ts",
    "@hypen-space/cf": "../../../hypen-web/packages/cf/src/index.ts"
  },

  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false },
    { "type": "Text", "globs": ["**/*.hypen", "**/*.svg", "**/dist/client/*.js"], "fallthrough": true }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "FOOD_ORDERING_DO", "class_name": "FoodOrderingDurableObject" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FoodOrderingDurableObject"] }
  ],

  "observability": {
    "enabled": true
  }
}
