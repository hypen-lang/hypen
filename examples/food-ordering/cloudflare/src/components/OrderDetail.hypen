Column {
    Row {
        Button {
            Icon(@resources.arrow-left)
                .size(22)
                .color("#111827")
        }
        .tw("bg-transparent p-2")
        .onClick(@router.push, to: "/orders")

        Text("Order Details")
            .tw("text-base font-semibold flex-1 text-center")

        Column {}
            .tw("w-10")
    }
    .tw("py-2 px-2 items-center bg-white border-b border-gray-200")

    Column {
        Column {
            Row {
                Icon(@resources.check-circle)
                    .size(28)
                    .color("@{state.order.status == 'delivered' ? '#16a34a' : '#f97316'}")
                Column {
                    Text("@{state.order.statusLabel}")
                        .tw("text-base font-bold")
                    Text("@{state.order.statusDescription}")
                        .tw("text-xs text-gray-500 mt-0.5")
                }
                .tw("pl-3 flex-1")
            }
            .tw("items-center")
        }
        .tw("bg-white px-4 py-4 border-b border-gray-100")

        Column {
            Text("@{state.order.restaurantName}")
                .tw("text-sm font-bold")
            Text("Ordered @{state.order.placedAt}")
                .tw("text-xs text-gray-500 mt-0.5")

            Column {
                ForEach(items: @state.order.items, key: "id") {
                    Row {
                        Image(src: "@{item.imageUrl}")
                            .tw("w-12 h-12 rounded-md")
                            .objectFit("cover")

                        Column {
                            Text("@{item.quantity}x @{item.name}")
                                .tw("text-sm font-semibold")
                        }
                        .tw("flex-1 pl-3")

                        Text("$@{item.lineTotal}")
                            .tw("text-sm")
                    }
                    .tw("py-2 items-center")
                }
            }
            .tw("mt-3")
        }
        .tw("bg-white px-4 py-4 mt-2 border-b border-gray-100")

        Column {
            Text("Delivery address")
                .tw("text-sm font-bold")
            Text("@{state.order.address}")
                .tw("text-sm text-gray-600 mt-1")
        }
        .tw("bg-white px-4 py-4 mt-2 border-b border-gray-100")

        Column {
            Text("Payment summary")
                .tw("text-sm font-bold")

            Row {
                Text("Subtotal")
                    .tw("text-sm text-gray-600 flex-1")
                Text("$@{state.order.subtotal}")
                    .tw("text-sm")
            }
            .tw("mt-3 items-center")

            Row {
                Text("Delivery fee")
                    .tw("text-sm text-gray-600 flex-1")
                Text("$@{state.order.deliveryFee}")
                    .tw("text-sm")
            }
            .tw("mt-2 items-center")

            Column {}
                .tw("h-px bg-gray-200 my-3")

            Row {
                Text("Total")
                    .tw("text-base font-bold flex-1")
                Text("$@{state.order.total}")
                    .tw("text-base font-bold")
            }
            .tw("items-center")
        }
        .tw("bg-white px-4 py-4 mt-2")
    }
    .scrollable(true)
    .tw("flex-1")
}
.tw("flex-1 w-full bg-gray-50")
