Column {
    Column {
        Stack {
            Image(src: "@{state.restaurant.imageUrl}")
                .tw("w-full h-56 md:h-80 rounded-b-[28px] md:rounded-[32px]")
                .objectFit("cover")

            Button {
                Icon(@resources.arrow-left)
                    .size(22)
                    .color("#111827")
            }
            .tw("absolute top-4 left-4 w-10 h-10 rounded-full bg-white items-center justify-center shadow")
            .onClick(@router.push, to: "/")

            Button {
                Icon(@resources.heart)
                    .size(22)
                    .color("@{state.isFavorite ? '#ef4444' : '#111827'}")
            }
            .tw("absolute top-4 right-4 w-10 h-10 rounded-full bg-white items-center justify-center shadow")
            .onClick(@actions.toggleFavorite)
        }

        Column {
            Text("@{state.restaurant.name}")
                .tw("text-3xl md:text-5xl font-black")

            Text("@{state.restaurant.cuisine} · @{state.restaurant.description}")
                .tw("text-sm md:text-lg text-gray-600 mt-2 leading-6")

            Row {
                Row {
                    Icon(@resources.star)
                        .size(14)
                        .color("#f59e0b")
                    Text("@{state.restaurant.rating} (@{state.restaurant.ratingCount})")
                        .tw("text-sm font-semibold ml-1")
                }
                .tw("items-center bg-amber-50 border border-amber-100 rounded-full px-3 py-1")

                Row {
                    Icon(@resources.clock)
                        .size(14)
                        .color("#f97316")
                    Text("@{state.restaurant.deliveryTimeMin}-@{state.restaurant.deliveryTimeMax} min")
                        .tw("text-sm text-gray-700 ml-1")
                }
                .tw("items-center bg-orange-50 border border-orange-100 rounded-full px-3 py-1 ml-2")

                Text("$@{state.restaurant.deliveryFee} fee")
                    .tw("text-sm text-gray-700 bg-stone-100 border border-stone-200 rounded-full px-3 py-1 ml-2")
            }
            .tw("mt-4 items-center flex-wrap")
        }
        .tw("px-4 md:px-8 py-5 md:py-7 bg-white border-b border-orange-100")
    }
    .maxWidth(1180)
    .width("100%")
    .alignSelf("center")

    Column {
        Text("Menu")
            .tw("text-xl md:text-2xl font-black px-4 md:px-8 pt-5 pb-4")

        Column {
            ForEach(items: @state.menuItems, key: "id") {
                MenuItem()
            }
        }
        .display("grid")
        .gridTemplateColumns("repeat(auto-fit, minmax(260px, 1fr))")
        .gap(18)
        .tw("px-4 md:px-8 pb-28 md:pb-8")
    }
    .maxWidth(1180)
    .width("100%")
    .alignSelf("center")

    If(condition: "@{state.cartCount > 0}") {
        Button {
            Row {
                Column {
                    Text("@{state.cartCount} item@{state.cartCount > 1 ? 's' : ''} in cart")
                        .tw("text-xs text-white opacity-90")
                    Text("View cart")
                        .tw("text-base font-bold text-white")
                }
                .tw("flex-1")

                Text("$@{state.cartSubtotal}")
                    .tw("text-base font-bold text-white")
            }
            .tw("items-center")
        }
        .tw("fixed left-4 right-4 bottom-4 md:left-auto md:right-8 md:bottom-8 md:w-96 py-3 px-5 bg-orange-500 rounded-full shadow-xl")
        .onClick(@router.push, to: "/cart")
    }
}
.scrollable(true)
.tw("flex-1 bg-stone-50")
