Column {
    Row {
        Text("My Orders")
            .tw("text-xl font-bold flex-1")
    }
    .tw("px-4 py-4 bg-white border-b border-gray-100 items-center")

    If(condition: "@{length(state.orders) == 0}") {
        Column {
            Icon(@resources.receipt)
                .size(72)
                .color("#d1d5db")
            Text("No orders yet")
                .tw("text-base font-semibold mt-3 text-gray-500")
            Text("Your order history will appear here")
                .tw("text-sm text-gray-400 mt-1")

            Button {
                Text("Browse restaurants")
                    .tw("text-sm font-bold text-white")
            }
            .tw("bg-orange-500 rounded-full px-6 py-3 mt-6")
            .onClick(@router.push, to: "/")
        }
        .tw("flex-1 items-center justify-center px-4")
    }

    If(condition: "@{length(state.orders) > 0}") {
        Column {
            ForEach(items: @state.orders, key: "id") {
                Button {
                    Column {
                        Row {
                            Column {
                                Text("@{item.restaurantName}")
                                    .tw("text-sm font-bold")
                                Text("@{item.placedAt}")
                                    .tw("text-xs text-gray-500 mt-0.5")
                            }
                            .tw("flex-1")

                            Column {
                                Text("@{item.statusLabel}")
                                    .tw("text-xs font-semibold px-2 py-1 rounded")
                                    .color("@{item.status == 'delivered' ? '#16a34a' : item.status == 'on_the_way' ? '#f97316' : '#2563eb'}")
                                    .backgroundColor("@{item.status == 'delivered' ? '#dcfce7' : item.status == 'on_the_way' ? '#ffedd5' : '#dbeafe'}")
                            }
                            .tw("shrink-0")
                        }
                        .tw("items-start")

                        Text("@{item.itemsSummary}")
                            .tw("text-xs text-gray-600 mt-2")

                        Row {
                            Text("$@{item.total}")
                                .tw("text-sm font-bold flex-1")
                            Row {
                                Text("View details")
                                    .tw("text-xs text-orange-500 font-semibold")
                                Icon(@resources.chevron-right)
                                    .size(14)
                                    .color("#f97316")
                            }
                            .tw("items-center shrink-0")
                        }
                        .tw("mt-3 items-center")
                    }
                }
                .tw("bg-white rounded-xl p-4 mb-3 w-full")
                .onClick(@router.push, to: "/order/@{item.id}")
            }
        }
        .scrollable(true)
        .tw("flex-1 px-4 pt-4")
    }
}
.tw("flex-1 w-full bg-gray-50")
