module App {
    Router {
        Route(path: "/") {
            Column {
                HomePage()
                    .tw("flex-1")
                BottomNav()
            }
            .tw("flex-1 bg-stone-50")
        }

        Route(path: "/search") {
            Column {
                Search()
                    .tw("flex-1")
                BottomNav()
            }
            .tw("flex-1 bg-stone-50")
        }

        Route(path: "/cart") {
            Column {
                Cart()
                    .tw("flex-1")
                BottomNav()
            }
            .tw("flex-1 bg-stone-50")
        }

        Route(path: "/orders") {
            Column {
                Orders()
                    .tw("flex-1")
                BottomNav()
            }
            .tw("flex-1 bg-stone-50")
        }

        Route(path: "/profile") {
            Column {
                Profile()
                    .tw("flex-1")
                BottomNav()
            }
            .tw("flex-1 bg-stone-50")
        }

        Route(path: "/restaurant/:id") {
            RestaurantDetail()
        }

        Route(path: "/order/:id") {
            OrderDetail()
        }
    }
    .tw("flex-1 w-full h-full min-h-0")
}
.tw("flex-1 w-full h-screen min-h-0 overflow-hidden bg-stone-100")
