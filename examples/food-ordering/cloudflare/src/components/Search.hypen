Column {
    Row {
        Row {
            Icon(@resources.search)
                .size(18)
                .color("#9ca3af")
            Input(placeholder: "Search restaurants or dishes")
                .tw("flex-1 bg-transparent border-0 ml-2 text-sm")
                .bind(@state.searchQuery)
                .onInput(@actions.search)
        }
        .tw("flex-1 bg-stone-100 rounded-2xl px-4 py-3.5 items-center")
    }
    .tw("px-4 md:px-8 py-4 bg-white border-b border-gray-100")
    .maxWidth(1180)
    .width("100%")
    .alignSelf("center")

    If(condition: "@{length(state.searchQuery) == 0}") {
        Column {
            Text("Suggested searches")
                .tw("text-sm md:text-base font-bold text-gray-500 px-4 md:px-8 pt-2 pb-3")

            ForEach(items: @state.suggestions, key: "id") {
                Button {
                    Row {
                        Icon(@resources.search)
                            .size(16)
                            .color("#9ca3af")
                        Text("@{item.name}")
                            .tw("text-sm ml-3 flex-1 text-left")
                        Icon(@resources.chevron-right)
                            .size(16)
                            .color("#9ca3af")
                    }
                    .tw("items-center")
                }
                .tw("bg-white px-4 py-3 border-b border-gray-100 w-full")
                .opacity({ default: 1, active: 0.6 })
                .transition(150, easeOut)
                .onClick(@actions.applySuggestion, query: "@{item.name}")
            }
        }
        .scrollable(true)
        .tw("flex-1 bg-white")
        .maxWidth(1180)
        .width("100%")
        .alignSelf("center")
    }

    If(condition: "@{length(state.searchQuery) > 0}") {
        Column {
            Row {
                Text("Results for ")
                    .tw("text-xs text-gray-500")
                Text("@{state.searchQuery}")
                    .tw("text-xs font-semibold")
            }
            .tw("px-4 md:px-8 py-2 bg-stone-100 border-b border-gray-100")

            If(condition: "@{length(state.searchResults) == 0}") {
                Column {
                    Text("No restaurants match your search")
                        .tw("text-sm text-gray-500 mt-10 text-center")
                }
                .tw("px-4")
            }

            Grid(@state.searchResults, key: "id") {
                RestaurantCard()
            }
            .gridColumns({default: 1, md: 2, lg: 3, xl: 4, 2xl: 5})
            .gap(18)
            .tw("px-4 md:px-8 pt-4 pb-8 w-full")
        }
        .scrollable(true)
        .tw("flex-1")
        .maxWidth(1180)
        .width("100%")
        .alignSelf("center")
    }
}
.tw("flex-1 w-full bg-stone-50")
