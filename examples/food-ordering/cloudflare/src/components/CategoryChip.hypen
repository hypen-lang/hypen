Button {
    Text("@{item.name}")
        .tw("text-sm font-medium")
        .color("@{item.id == state.selectedCategory ? '#ffffff' : '#374151'}")
}
.tw("px-4 py-2 rounded-full border shrink-0")
.backgroundColor("@{item.id == state.selectedCategory ? '#f97316' : '#ffffff'}")
.borderColor("@{item.id == state.selectedCategory ? '#f97316' : '#e5e7eb'}")
.onClick(@actions.selectCategory, categoryId: "@{item.id}")
