{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hypen-movie-discovery",
  "main": "src/worker.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],

  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false },
    { "type": "Text", "globs": ["**/dist/client/*.js"], "fallthrough": true }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "MOVIE_DISCOVERY_DO", "class_name": "MovieDiscoveryDO" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MovieDiscoveryDO"] }
  ],

  // OMDB_API_KEY is a secret: put it in .dev.vars for `wrangler dev`
  // (see .dev.vars.example) or `wrangler secret put OMDB_API_KEY` for deploys.
  // Without a working key the app serves its bundled fallback catalog.

  "observability": {
    "enabled": true
  }
}
