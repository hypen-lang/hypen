{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hypen-simple",
  "main": "src/worker.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // The Hypen WASM engine is pulled in as a CompiledWasm module — this rule is
  // what lets the engine boot inside a Worker.
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false },
    { "type": "Text", "globs": ["**/dist/client/*.js"], "fallthrough": true }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "SIMPLE_DO", "class_name": "SimpleDO" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SimpleDO"] }
  ]
}
