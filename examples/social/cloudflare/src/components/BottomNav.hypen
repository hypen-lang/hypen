// Every tab gets the same press feedback: a short opacity + scale dip on
// `active`, glided by a 140ms transition so the release eases back instead of
// snapping. `.transform` (whole string) rather than `.scale` — transform
// applicators compose into one CSS property and so do not support variants.
Row {
    Button {
        Icon(@resources.home)
            .size({default: 22, md: 28})
            .color("@{state.location == '/' ? '#262626' : '#8e8e8e'}")
    }
    .tw("flex-1 bg-transparent border-0 py-2 items-center justify-center")
    .opacity({default: 1, active: 0.45})
    .transform({default: "scale(1)", active: "scale(0.86)"})
    .transition(duration: 140, curve: easeOut, props: [opacity, scale])
    .onClick(@router.push, to: "/")

    Button {
        Icon(@resources.search)
            .size({default: 22, md: 28})
            .color("@{state.location == '/search' ? '#262626' : '#8e8e8e'}")
    }
    .tw("flex-1 bg-transparent border-0 py-2 items-center justify-center")
    .opacity({default: 1, active: 0.45})
    .transform({default: "scale(1)", active: "scale(0.86)"})
    .transition(duration: 140, curve: easeOut, props: [opacity, scale])
    .onClick(@router.push, to: "/search")

    Button {
        Icon(@resources.plus-square)
            .size({default: 24, md: 30})
            .color("@{state.location == '/create' ? '#262626' : '#8e8e8e'}")
    }
    .tw("flex-1 bg-transparent border-0 py-2 items-center justify-center")
    .opacity({default: 1, active: 0.45})
    .transform({default: "scale(1)", active: "scale(0.86)"})
    .transition(duration: 140, curve: easeOut, props: [opacity, scale])
    .onClick(@router.push, to: "/create")

    Button {
        Icon(@resources.heart)
            .size({default: 22, md: 28})
            .color("@{state.location == '/notifications' ? '#262626' : '#8e8e8e'}")
    }
    .tw("flex-1 bg-transparent border-0 py-2 items-center justify-center")
    .opacity({default: 1, active: 0.45})
    .transform({default: "scale(1)", active: "scale(0.86)"})
    .transition(duration: 140, curve: easeOut, props: [opacity, scale])
    .onClick(@router.push, to: "/notifications")

    Button {
        Image(src: "@{state.currentUser.avatarUrl}")
            .tw("w-7 h-7 rounded-full")
            .width({default: 24, md: 30})
            .height({default: 24, md: 30})
    }
    .tw("flex-1 bg-transparent border-0 py-2 items-center justify-center")
    .opacity({default: 1, active: 0.45})
    .transform({default: "scale(1)", active: "scale(0.86)"})
    .transition(duration: 140, curve: easeOut, props: [opacity, scale])
    .onClick(@router.push, to: "/profile")
}
.tw("px-3 py-1 bg-white border-t border-gray-200 items-center justify-around")
