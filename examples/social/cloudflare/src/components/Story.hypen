module Story {
    Column {
        Row {
            Image(src: "@{state.story.user.avatarUrl}")
                .tw("size-8 rounded-full")

            Text("@{state.story.user.username}")
                .tw("text-sm font-semibold text-white pl-2 flex-1")

            Button {
                Text("✕")
                    .tw("text-lg text-white")
            }
            .onClick(@router.push, to: "/")
            .tw("bg-transparent p-2")
        }
        .tw("py-3 px-4 items-center absolute top-0 left-0 right-0 z-10")
        // The chrome arrives just after the hero lands, so the two motions read
        // as one sequence rather than a pile-up.
        .enter(slide, fade, from: top, duration: 260, delay: 160)

        // Destination half of the story hero flight (see StoryItem.hypen).
        Image(src: "@{state.story.imageUrl}")
            .tw("w-full flex-1")
            .objectFit("cover")
            .sharedElement("story-@{state.story.id}", curve: spring, duration: 380)
    }
    .tw("flex-1 w-full bg-black relative")
}
