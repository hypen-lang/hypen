Row {
    Column {
        Stack {
            Image(src: "@{state.currentUser.avatarUrl}")
                .tw("w-14 h-14 rounded-full")
            Column {
                Icon(@resources.plus)
                    .size(14)
                    .color("#ffffff")
            }
            .tw("w-5 h-5 rounded-full bg-blue-500 items-center justify-center")
            .marginTop(36)
            .marginLeft(36)
        }

        Text("Your story")
            .tw("text-xs text-gray-500 mt-1")
    }
    .tw("items-center py-1 px-1 w-20 shrink-0")

    ForEach(items: @state.stories, key: "id") {
        StoryItem()
    }
}
.tw("flex-row pl-3 pr-1 py-2 border-b border-gray-200")
.scrollable("horizontal")
