module App {
    Column {
    Router {
        Route(path: "/") {
            Column {
                HomePage()
                    .tw("flex-1 min-h-0")
                BottomNav()
                    .tw("shrink-0")
            }
            .tw("flex-1 h-full min-h-0 overflow-hidden bg-white")
        }

        Route(path: "/search") {
            Column {
                Search()
                    .tw("flex-1 min-h-0")
                BottomNav()
                    .tw("shrink-0")
            }
            .tw("flex-1 h-full min-h-0 overflow-hidden bg-white")
        }

        Route(path: "/notifications") {
            Column {
                Notifications()
                    .tw("flex-1 min-h-0")
                BottomNav()
                    .tw("shrink-0")
            }
            .tw("flex-1 h-full min-h-0 overflow-hidden bg-white")
        }

        Route(path: "/messages") {
            Column {
                Messages()
                    .tw("flex-1 min-h-0")
                BottomNav()
                    .tw("shrink-0")
            }
            .tw("flex-1 h-full min-h-0 overflow-hidden bg-white")
        }

        Route(path: "/profile") {
            Column {
                Profile()
                    .tw("flex-1 min-h-0")
                BottomNav()
                    .tw("shrink-0")
            }
            .tw("flex-1 h-full min-h-0 overflow-hidden bg-white")
        }

        Route(path: "/user-profile/:id") {
            Column {
                UserProfile()
                    .tw("flex-1 min-h-0")
                BottomNav()
                    .tw("shrink-0")
            }
            .tw("flex-1 h-full min-h-0 overflow-hidden bg-white")
        }

        Route(path: "/comments/:postId") {
            Comments()
        }

        Route(path: "/story/:id") {
            Story()
        }
    }
    .tw("flex-1 w-full h-full min-h-0 overflow-hidden")
    }
    .tw("flex-1 w-full h-screen min-h-0 overflow-hidden bg-white")
}
