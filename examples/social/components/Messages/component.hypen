module Messages {
    Column {
        Row {
            Button {
                Text("←")
                    .tw("text-xl")
            }
            .onClick(@router.push, to: "/")
            .tw("w-10 h-10 bg-transparent border-0 p-2 rounded-xl items-center justify-center hover:bg-gray-100")

            Text("@{state.currentUser.username}")
                .tw("text-base font-semibold flex-1 text-center")

            Column {}
                .tw("w-10")
        }
        .tw("py-2 px-2 items-center bg-white border-b border-gray-200")

        List(@state.messages, key: "id") {
            Row {
                Image(src: "@{item.user.avatarUrl}")
                    .width(48)
                    .height(48)
                    .tw("rounded-full shrink-0")

                Column {
                    Text("@{item.user.username}")
                        .tw("text-sm font-semibold")
                    Row {
                        Text("@{item.lastMessage}")
                            .tw("text-sm text-gray-400")
                        Text(" · @{item.timeAgo}")
                            .tw("text-sm text-gray-400")
                    }
                }
                .tw("pl-3 flex-1 min-w-0")

                Column {
                    If(condition: "@{item.isUnread}") {
                        Column {}
                            .tw("size-2 rounded-full bg-blue-500")
                    }
                }
                .tw("w-4 items-center")
            }
            .tw("mx-3 my-1 py-3 px-3 items-center cursor-pointer rounded-2xl overflow-hidden hover:bg-gray-100")
            .onClick(@router.push, to: "/dm/@{item.id}")
        }
        .tw("flex-1 py-1")
    }
    .tw("flex-1 w-full bg-white md:max-w-[630px] md:border-x md:border-gray-200")
    .alignSelf("center")
}
