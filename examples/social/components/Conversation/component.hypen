module Conversation {
    Column {
        Row {
            Button {
                Text("←")
                    .tw("text-xl")
            }
            .onClick(@router.push, to: "/messages")
            .tw("w-10 h-10 bg-transparent border-0 p-2 rounded-xl items-center justify-center hover:bg-gray-100")

            Image(src: "@{state.peer.avatarUrl}")
                .tw("size-8 rounded-full shrink-0")

            Text("@{state.peer.username}")
                .tw("text-base font-semibold flex-1 pl-3")

            Column {}
                .tw("w-10")
        }
        .tw("py-2 px-2 items-center bg-white border-b border-gray-200")

        // Sent messages render as a right-aligned blue bubble, received ones
        // as a left-aligned gray bubble with the sender's avatar.
        List(@state.chatMessages, key: "id") {
            Row {
                Image(src: "@{item.avatarUrl}")
                    .width("@{item.isMine ? 0 : 28}")
                    .height("@{item.isMine ? 0 : 28}")
                    .opacity("@{item.isMine ? 0 : 1}")
                    .tw("rounded-full shrink-0")

                Column {
                    Text("@{item.text}")
                        .fontSize(14)
                        .color("@{item.isMine ? '#ffffff' : '#111827'}")
                }
                .backgroundColor("@{item.isMine ? '#3b82f6' : '#f3f4f6'}")
                .borderRadius(18)
                .paddingVertical(8)
                .paddingHorizontal(14)
                .marginLeft("@{item.isMine ? 0 : 8}")
                .tw("max-w-[75%]")
            }
            .justifyContent("@{item.isMine ? 'flex-end' : 'flex-start'}")
            .tw("w-full items-end px-4 py-1")
        }
        .tw("flex-1 py-3")
        .scrollable(true)

        Row {
            Input(placeholder: "Message...")
                .bind(@state.draft)
                .onKey(@actions.sendMessage)
                .tw("flex-1 bg-gray-100 rounded-full px-4 py-2 text-sm border-0")

            Button {
                Text("Send")
                    .tw("text-sm font-semibold text-blue-500")
            }
            .tw("bg-transparent border-0 ml-2 px-3 py-2 rounded-full hover:bg-blue-50")
            .onClick(@actions.sendMessage)
        }
        .tw("py-2 px-3 items-center bg-white border-t border-gray-200")
    }
    .tw("flex-1 w-full h-full min-h-0 bg-white md:max-w-[630px] md:mx-auto md:border-x md:border-gray-200")
    .alignSelf("center")
}
